{
  "name": "@orvex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "build": "pnpm clean && tsdown",
    "lint": "eslint .",
    "typecheck": "orvex-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orvex/auth": "workspace:*",
    "@orvex/cache": "workspace:*",
    "@orvex/db": "workspace:*",
    "@orvex/logger": "workspace:*",
    "@orvex/types": "workspace:*",
    "@trpc/server": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orvex/config": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
