{
  "name": "@orvex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "build": "pnpm clean && tsdown",
    "lint": "eslint .",
    "typecheck": "orvex-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orvex/auth": "workspace:*",
    "@orvex/cache": "workspace:*",
    "@orvex/db": "workspace:*",
    "@orvex/logger": "workspace:*",
    "@orvex/types": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@trpc/server": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "file-type": "^22.0.2",
    "helmet": "catalog:",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orvex/config": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
