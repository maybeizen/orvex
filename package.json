{
  "name": "orvex-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@orvex/agent",
    "dev:agent": "turbo run dev --filter=@orvex/agent",
    "build": "NODE_ENV=production turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "supabase": "supabase",
    "db:list": "pnpm supabase migration list --linked",
    "db:push": "pnpm supabase db push --linked",
    "db:lint": "pnpm supabase db lint --linked",
    "gen:types": "pnpm supabase gen types typescript --linked > packages/types/src/database.ts"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "catalog:"
  }
}
