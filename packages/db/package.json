{
  "name": "@orvex/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "build": "pnpm clean && tsdown",
    "lint": "eslint .",
    "typecheck": "orvex-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orvex/types": "workspace:*",
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@orvex/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
